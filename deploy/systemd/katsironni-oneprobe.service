[Unit]
Description=Oneprobe Hosted (hosted oneprobe)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=katsironni
Group=katsironni
WorkingDirectory=/opt/katsironni/services/oneprobe
ExecStart=/opt/katsironni/bin/oneprobe serve --http=127.0.0.1:8104 --db=/opt/katsironni/services/oneprobe/data/oneprobe.db
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/katsironni/services/oneprobe/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
